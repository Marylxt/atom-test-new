# =========================================================
# Atoms Demo · 后端环境变量
# 复制为 .env 后按需修改
# =========================================================

# ---------- 基础 ----------
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 前端地址，用于拼接「发布后的公开链接」
PUBLIC_BASE_URL=http://localhost:3000

# ---------- Supabase ----------
# 控制台 → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=xxxx
# service_role key（仅后端使用，切勿暴露给前端）
SUPABASE_SERVICE_KEY=xxxx
# 控制台 → Project Settings → API → JWT Settings → JWT Secret（HS256 校验用）
SUPABASE_JWT_SECRET=xxxx
# 如果项目已经切换到非对称签名（ES256/RS256），填 JWKS 地址；留空则自动推导
# SUPABASE_JWKS_URL=https://xxxx.supabase.co/auth/v1/.well-known/jwks.json
# 建表脚本用：Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=

# ---------- Supabase 连接调优（跨国链路上很重要）----------
# httpx 默认 keepalive_expiry=5s，会频繁重做 TLS 握手。实测本地 → Supabase 悉尼：
# 新建连接 2~17s，复用 0.5s；中间设备空闲数十秒就断连。
# 所以：拉长保活 + 后台每 20s 打一个轻量查询把连接焐住
SUPABASE_KEEPALIVE=300
SUPABASE_TIMEOUT=30
SUPABASE_KEEPALIVE_INTERVAL=20

# ---------- 存储后端 ----------
# auto（默认）：配了 Supabase 就用 Supabase，没配就自动落到本地 SQLite
# supabase：强制云端；sqlite：强制本地（离线演示用）
STORAGE_BACKEND=auto
SQLITE_PATH=data/atoms.db

# ---------- LLM ----------
# auto（推荐）：填了 DEEPSEEK_API_KEY 就用云端，没填自动回落本地 Ollama
# 也可以显式写 deepseek / ollama
LLM_PROVIDER=auto
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000

DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名会随官方迭代变化，务必以 `GET {DEEPSEEK_BASE_URL}/models` 返回的为准。
# 2026-09 实测账号下可用：deepseek-flash（快，121 字符/秒）、deepseek-v4-pro（重推理，约 18 字符/秒）
DEEPSEEK_MODEL=deepseek-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# 上下文窗口。CPU 推理时越小越快，单页应用的 prompt + 产物 16k 足够
OLLAMA_NUM_CTX=16384

# ---------- 生成流水线 ----------
# 是否在「产品经理 → 架构师 → 工程师」之后再接力一位测试工程师做评审
ENABLE_QA_STAGE=false
# 是否逐 token 推送（true 时前端能看到实时打字效果）
STREAM_TOKENS=true
# 工具模式：chain（流式链式编排，默认） | tool（LangChain @tool 接力）
AGENT_MODE=chain

# ---------- 认证 ----------
# 本地没接 Supabase 时置 true，所有请求都当作同一个「本地开发账号」处理
AUTH_DISABLED=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001
