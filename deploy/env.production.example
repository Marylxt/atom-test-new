# ============================================================
# 线上部署环境变量对照表（填到部署平台的控制台里）
# 用法：本地 backend/.env 里的 Supabase / DeepSeek 值直接复制过来，
#      只有标注 [必填] 的三项需要按实际域名修改。
# ============================================================

# ---------- 后端服务（FastAPI 容器）----------

# 前端最终可访问的地址（发布短链、CORS 白名单都基于它）
# 例：https://atoms-demo.xxx.com
PUBLIC_BASE_URL=[必填] 前端域名
CORS_ORIGINS=[必填] 前端域名           # 多个用英文逗号分隔

# --- Supabase：与本地 .env 完全一致，直接复制 ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
STORAGE_BACKEND=supabase               # 线上强制走 Supabase，避免误落到容器内 SQLite

# --- LLM：线上必须显式写 deepseek ---
# 容器里没有 Ollama，虽然 auto 也会解析成 deepseek，但显式写死可避免误判
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=5000
STREAM_TOKENS=true
AGENT_MODE=chain
ENABLE_QA_STAGE=false

# --- 认证 ---
# true  = 免登录，评审/面试官可直接进工作台，但公网任何人拿到链接都能调用生成接口，
#         会消耗你的 DeepSeek 额度（当前 Demo 没有配额和限流）
# false = 启用 Supabase 登录，更安全，但访问者需要先注册账号
AUTH_DISABLED=[必填] true 或 false
DEBUG=false


# ---------- 前端服务（Next.js）----------
# ⚠️ NEXT_PUBLIC_* 是「构建期」内联进客户端产物的：
#    如果你用容器平台构建，必须作为 build-args 传入；
#    只在运行期注入环境变量是无效的（页面会去连 localhost:8000）。

NEXT_PUBLIC_API_BASE_URL=[必填] 后端域名     # 例如 https://atoms-api.xxx.com
NEXT_PUBLIC_SUPABASE_URL=                    # 与后端 SUPABASE_URL 相同
NEXT_PUBLIC_SUPABASE_ANON_KEY=               # 与后端 SUPABASE_ANON_KEY 相同
